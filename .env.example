# Tavily key for web search and page extraction (https://tavily.com, free tier is enough).
TAVILY_API_KEY=
# Key for the OpenAI-compatible LLM endpoint (OpenRouter by default).
LLM_API_KEY=
# Base URL of the OpenAI-compatible endpoint. Default: https://openrouter.ai/api/v1
LLM_BASE_URL=
# Model name sent to that endpoint. Default: anthropic/claude-haiku-5.5
LLM_MODEL=
# live = real web, record = real web and save fixtures/web/*.json, replay = read fixtures only (no Tavily key needed).
WEB_MODE=live
# Pretend "now" is this ISO time (for repeatable demos and tests), e.g. 2026-11-23T09:00:00Z. Leave empty for the real time.
AGENT_NOW=
# debug, info, warn, error or silent. Default: info
LOG_LEVEL=info
